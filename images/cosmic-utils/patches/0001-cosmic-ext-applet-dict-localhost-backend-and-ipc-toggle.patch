index 0000000..09fa4d4
--- /dev/null
+++ b/src/dict_client.rs
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::collections::BTreeMap;
+use std::io::{BufRead, BufReader, Write};
+use std::net::TcpStream;
+use std::time::Duration;
+use crate::{Definition, Entry};
+
+/// Connect to a DICT server (RFC 2229) and query word definitions.
+pub fn fetch_words_dict_server(
+    server_addr: &str,
+    search_q: Option<&str>,
+) -> Result<Vec<Entry>, String> {
+    let stream = TcpStream::connect_timeout(
+        &server_addr
+            .parse()
+            .map_err(|e| format!("Invalid server address {}: {}", server_addr, e))?,
+        Duration::from_millis(1500),
+    )
+    .map_err(|e| format!("Connection to {} failed: {}", server_addr, e))?;
+
+    stream
+        .set_read_timeout(Some(Duration::from_millis(3000)))
+        .ok();
+    stream
+        .set_write_timeout(Some(Duration::from_millis(3000)))
+        .ok();
+
+    let mut reader = BufReader::new(stream.try_clone().map_err(|e| format!("{}", e))?);
+    let mut writer = stream;
+
+    let mut banner = String::new();
+    reader
+        .read_line(&mut banner)
+        .map_err(|e| format!("Failed to read banner: {}", e))?;
+    if !banner.starts_with("220") {
+        return Err(format!("Invalid DICT banner: {}", banner.trim()));
+    }
+
+    let query_str = search_q.unwrap_or("hello").trim();
+    if query_str.is_empty() {
+        return Ok(vec![]);
+    }
+
+    let mut entries = query_define(&mut reader, &mut writer, query_str)?;
+
+    if entries.is_empty() && search_q.is_some() {
+        if let Ok(matches) = query_match(&mut reader, &mut writer, query_str) {
+            for matched_word in matches.iter().take(3) {
+                if let Ok(def_entries) = query_define(&mut reader, &mut writer, matched_word) {
+                    entries.extend(def_entries);
+                }
+            }
+        }
+    }
+
+    let _ = writer.write_all(b"QUIT\r\n");
+
+    if entries.is_empty() {
+        Err("No definitions found on DICT server".to_string())
+    } else {
+        Ok(entries)
+    }
+}
+
+fn query_define<R: BufRead, W: Write>(
+    reader: &mut R,
+    writer: &mut W,
+    word: &str,
+) -> Result<Vec<Entry>, String> {
+    let cmd = format!("DEFINE * {}\r\n", word);
+    writer
+        .write_all(cmd.as_bytes())
+        .map_err(|e| format!("Write error: {}", e))?;
+    writer.flush().map_err(|e| format!("Flush error: {}", e))?;
+
+    let mut entries_map: BTreeMap<String, Vec<Definition>> = BTreeMap::new();
+    let mut current_word = word.to_string();
+    let mut current_db = String::new();
+    let mut current_def = String::new();
+    let mut in_def = false;
+
+    loop {
+        let mut line = String::new();
+        if reader.read_line(&mut line).map_err(|e| format!("Read error: {}", e))? == 0 {
+            break;
+        }
+
+        if in_def {
+            if line == ".\r\n" || line == ".\n" {
+                in_def = false;
+                entries_map
+                    .entry(current_word.clone())
+                    .or_default()
+                    .push(Definition {
+                        speech_part: current_db.clone(),
+                        def: current_def.trim().to_string(),
+                        example: String::new(),
+                    });
+                current_def.clear();
+            } else {
+                let trimmed_line = if line.starts_with("..") {
+                    &line[1..]
+                } else {
+                    &line
+                };
+                current_def.push_str(trimmed_line);
+            }
+            continue;
+        }
+
+        if line.starts_with("150") {
+            continue;
+        }
+
+        if line.starts_with("151") {
+            in_def = true;
+            current_def.clear();
+            let parts: Vec<&str> = line.split_whitespace().collect();
+            if parts.len() >= 3 {
+                current_word = parts[1].trim_matches('"').to_string();
+                current_db = parts[2].trim_matches('"').to_string();
+            }
+            continue;
+        }
+
+        if line.starts_with("250")
+            || line.starts_with("552")
+            || line.starts_with("500")
+            || line.starts_with("501")
+        {
+            break;
+        }
+    }
+
+    let mut result = Vec::new();
+    for (w, defs) in entries_map {
+        result.push(Entry { word: w, defs });
+    }
+    Ok(result)
+}
+
+fn query_match<R: BufRead, W: Write>(
+    reader: &mut R,
+    writer: &mut W,
+    prefix: &str,
+) -> Result<Vec<String>, String> {
+    let cmd = format!("MATCH * prefix {}\r\n", prefix);
+    writer
+        .write_all(cmd.as_bytes())
+        .map_err(|e| format!("Write error: {}", e))?;
+    writer.flush().map_err(|e| format!("Flush error: {}", e))?;
+
+    let mut matches = Vec::new();
+    let mut in_matches = false;
+
+    loop {
+        let mut line = String::new();
+        if reader.read_line(&mut line).map_err(|e| format!("Read error: {}", e))? == 0 {
+            break;
+        }
+
+        if line.starts_with("152") {
+            in_matches = true;
+            continue;
+        }
+
+        if in_matches {
+            if line == ".\r\n" || line == ".\n" {
+                break;
+            }
+            if let Some(first_quote) = line.find('"') {
+                if let Some(last_quote) = line.rfind('"') {
+                    if last_quote > first_quote {
+                        let matched_word = line[first_quote + 1..last_quote].to_string();
+                        if !matches.contains(&matched_word) {
+                            matches.push(matched_word);
+                        }
+                    }
+                }
+            }
+            continue;
+        }
+
+        if line.starts_with("250") || line.starts_with("552") {
+            break;
+        }
+    }
+
+    Ok(matches)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // Requires a live DICT server at 127.0.0.1:2628; not run by default in CI.
+    #[test]
+    #[ignore]
+    fn test_fetch_words_localhost() {
+        let res = fetch_words_dict_server("127.0.0.1:2628", Some("hello"));
+        assert!(res.is_ok(), "Expected OK response from localhost DICT server");
+        let entries = res.unwrap();
+        assert!(!entries.is_empty(), "Expected definitions for 'hello'");
+    }
+}
