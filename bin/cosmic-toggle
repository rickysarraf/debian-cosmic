#!/bin/bash
# COSMIC Switchboard Toggle
# Part of the Debian-COSMIC / Desktop Brewery Project

SET_STATE=$1
EXT_ROOT="/var/lib/extensions"
CORE_EXT="$EXT_ROOT/cosmic"

usage() {
    echo "Usage: cosmic-toggle [on|off|status]"
    exit 1
}

check_extensions() {
    echo "🔍 Checking COSMIC extension status..."

    # Verify the core sysext has been downloaded
    if [ ! -d "$CORE_EXT" ]; then
        echo "❌ Error: COSMIC sysext extension not found at $CORE_EXT"
        echo "   Run 'cosmic-update' first to download and install the COSMIC extension."
        exit 1
    fi

    # Check for broken host dependencies (ABI drift indicator)
    if ! sudo apt-get check >/dev/null 2>&1; then
        echo "⚠️  Warning: System has unmet dependencies. Possible ABI drift detected!"
        echo "   Run 'sudo apt-get -f install' to see the conflict. You may need to run 'cosmic-update'."
        exit 1
    fi

    echo "✅ Extension check passed."
}

case "$SET_STATE" in
    on)
        check_extensions
        echo "🚀 Merging COSMIC extension..."
        sudo systemd-sysext merge
        echo "✅ COSMIC is now active. Please restart GDM or log out manually."
        ;;
    off)
        echo "🔌 Unmerging COSMIC extension..."
        sudo systemd-sysext unmerge
        echo "✅ COSMIC is now inactive."
        ;;
    status)
        if systemd-sysext status | grep -q "cosmic"; then
            echo "🟢 STATUS: COSMIC Extension is ACTIVE."
        else
            echo "⚪ STATUS: COSMIC Extension is INACTIVE."
        fi
        echo "--- Details ---"
        systemd-sysext status
        ;;
    *)
        usage
        ;;
esac
